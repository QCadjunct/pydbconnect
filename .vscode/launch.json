{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python Debugger: Current File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "env": {
                "PYTHONPATH": "${workspaceFolder}"
            }
        },
        // Optional: Additional configuration for running a specific module
        {
            "name": "Python Debugger: Run Module",
            "type": "debugpy",
            "request": "launch",
            "module": "core.connector", // Replace with your actual module name
            "console": "integratedTerminal",
            "env": {
                "PYTHONPATH": "${workspaceFolder}"
            }
        }
    ]
}