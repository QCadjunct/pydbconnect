{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python: Current File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "env": {
                "PYTHONPATH": "${workspaceFolder}"
            },
            "justMyCode": false
        },
        {
            "name": "Debug Core Example",
            "type": "debugpy",
            "request": "launch",
            "module": "core.examples.${fileBasenameNoExtension}",
            "console": "integratedTerminal",
            "envFile": "${workspaceFolder}/.env",
            "env": {
                "PYTHONPATH": "${workspaceFolder}"
            },
            "justMyCode": false,
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "Debug complex_multi_db_transfer.py",
            "type": "debugpy",
            "request": "launch",
            "module": "core.examples.complex_multi_db_transfer",
            "console": "integratedTerminal",
            "envFile": "${workspaceFolder}/.env",
            "env": {
                "PYTHONPATH": "${workspaceFolder}"
            },
            "justMyCode": false,
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "Debug simple_multi_db_sync.py",
            "type": "debugpy",
            "request": "launch",
            "module": "core.examples.simple_multi_db_sync",
            "console": "integratedTerminal",
            "envFile": "${workspaceFolder}/.env",
            "env": {
                "PYTHONPATH": "${workspaceFolder}"
            },
            "justMyCode": false,
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "Debug connector.py",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/core/connector.py",
            "console": "integratedTerminal",
            "envFile": "${workspaceFolder}/.env",
            "env": {
                "PYTHONPATH": "${workspaceFolder}"
            },
            "justMyCode": false,
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "Debug Test Example",
            "type": "debugpy",
            "request": "launch",
            "module": "tests.example_poc modules.${fileBasenameNoExtension}",
            "console": "integratedTerminal",
            "envFile": "${workspaceFolder}/.env",
            "env": {
                "PYTHONPATH": "${workspaceFolder}"
            },
            "justMyCode": false,
            "cwd": "${workspaceFolder}"
        }
    ]
}