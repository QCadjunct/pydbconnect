# PyDatabaseConnection API Documentation

## 1. Core Classes

### 1.1 DatabaseConnection
```python
class DatabaseConnection:
    """
    Main database connection class providing fluent interface for database operations.
    
    Attributes:
        template_manager (TemplateManager): Manages database engine templates
        use_dsn (bool): Whether to use DSN for connection
        is_connected (bool): Connection status
        in_transaction (bool): Transaction status
    """
    
    def __init__(self, engine_type: str, use_dsn: bool = False):
        """
        Initialize database connection.

        Args:
            engine_type (str): Type of database engine ("MSSQL", "POSTGRESQL", etc.)
            use_dsn (bool): Whether to use DSN for connection
        """
        
    def with_credentials(self, username: str, password: str) -> 'DatabaseConnection':
        """
        Set database credentials.

        Args:
            username (str): Database username
            password (str): Database password

        Returns:
            DatabaseConnection: Self for method chaining

        Raises:
            DatabaseConnectionError: If credentials are invalid
        """
        
    def with_credentials_from_env(self) -> 'DatabaseConnection':
        """
        Load credentials from environment variables.

        Environment variables should be in format:
        {ENGINE_TYPE}_USERNAME and {ENGINE_TYPE}_PASSWORD

        Returns:
            DatabaseConnection: Self for method chaining

        Raises:
            DatabaseConnectionError: If environment variables not found
        """
        
    def with_params(self, **params: Any) -> 'DatabaseConnection':
        """
        Set connection parameters.

        Args:
            **params: Connection parameters (SERVER, PORT_NUMBER, etc.)

        Returns:
            DatabaseConnection: Self for method chaining

        Raises:
            DatabaseConnectionError: If invalid parameters provided
        """
```

### 1.2 DataFrame Operations
```python
def execute_sql_to_panda_dataframe(
    self,
    sql_command: str,
    index_column: Optional[str] = None,
    return_dataframe: bool = True
) -> Union['DatabaseConnection', pd.DataFrame]:
    """
    Execute SQL query and return results as pandas DataFrame.

    Args:
        sql_command (str): SQL query to execute
        index_column (str, optional): Column to use as DataFrame index
        return_dataframe (bool): Whether to return DataFrame or self

    Returns:
        Union[DatabaseConnection, pd.DataFrame]: DataFrame or self for chaining

    Raises:
        DatabaseOperationError: If query execution fails
    """

def transform_dataframe(
    self,
    transformation: Union[Callable[[pd.DataFrame], pd.DataFrame], str],
    columns: Optional[List[str]] = None,
    **kwargs: Any
) -> 'DatabaseConnection':
    """
    Apply transformation to current DataFrame.

    Args:
        transformation: Callable or predefined transformation name
        columns: Columns to transform
        **kwargs: Additional transformation parameters

    Returns:
        DatabaseConnection: Self for method chaining

    Raises:
        DataFrameOperationError: If transformation fails
    """
```

### 1.3 Transaction Management
```python
@contextmanager
def transaction(self):
    """
    Context manager for database transactions.

    Usage:
        with db.transaction():
            db.execute("INSERT INTO ...")
            db.execute("UPDATE ...")

    Raises:
        DatabaseError: If transaction fails
    """

def begin_transaction(self) -> 'DatabaseConnection':
    """Start a new transaction."""

def commit(self) -> 'DatabaseConnection':
    """Commit current transaction."""

def rollback(self) -> 'DatabaseConnection':
    """Rollback current transaction."""
```

