            c.CustomerID,
            c.CompanyName,
            COUNT(o.OrderID) as OrderCount,
            SUM(od.Quantity * od.UnitPrice) as TotalRevenue
        FROM Customers c
        LEFT JOIN Orders o ON c.CustomerID = o.CustomerID
        LEFT JOIN [Order Details] od ON o.OrderID = od.OrderID
