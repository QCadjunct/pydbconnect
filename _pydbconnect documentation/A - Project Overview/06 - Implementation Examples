```python
# SQLite with DataFrame Operations
db = DatabaseConnection("SQLITE3") \
    .with_params(
        DATABASE_NAME="analytics.db",
        FULLY_QUALIFIED_PATH="/path/to/data"
    ) \
    .connect()

# Create table from DataFrame
df = pd.DataFrame({
    'date': pd.date_range('2024-01-01', periods=100),
    'value': np.random.randn(100)
})

# Create table and insert data
db.execute("""
    CREATE TABLE IF NOT EXISTS metrics (
        id INTEGER PRIMARY KEY AUTOINCREMENT,
        date TEXT,
        value REAL
    )
""")

# Bulk insert with generator
def chunked_insert(df: pd.DataFrame, chunk_size: int = 1000):
    for i in range(0, len(df), chunk_size):
        yield df.iloc[i:i + chunk_size]

with db.transaction():
    for chunk in chunked_insert(df):
        db.bulk_insert("metrics", chunk)

# Analysis with window functions
results = db.execute_sql_to_panda_dataframe("""
    SELECT 
        date,
        value,
        AVG(value) OVER (
            ORDER BY date 
            ROWS BETWEEN 7 PRECEDING AND CURRENT ROW
        ) as moving_avg,
        value - LAG(value) OVER (ORDER BY date) as daily_change
    FROM metrics
    ORDER BY date
""")
```

