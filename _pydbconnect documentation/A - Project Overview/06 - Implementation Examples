def run_analytics_pipeline(
    db: DatabaseConnection,
    start_date: str,
    end_date: str
):
    """Complex analytics pipeline with multiple stages"""
    
    # Stage 1: Data Extraction
    raw_data = db.execute_sql_to_panda_dataframe("""
        SELECT * FROM raw_events
        WHERE event_date BETWEEN ? AND ?
    """, params=(start_date, end_date))
    
    # Stage 2: Data Transformation
    transformed = (db
        .transform_dataframe(lambda df: df.pivot_table(
            index='event_date',
            columns='event_type',
            values='value',
            aggfunc='sum'
        ))
        .transform_dataframe('fillna', value=0)
        .transform_dataframe(lambda df: df.rolling(window=7).mean())
    )
    
    # Stage 3: Aggregation
    aggregated = db.aggregate(
        group_by=['event_date', 'event_type'],
        aggs={
            'value': ['sum', 'mean', 'std'],
            'user_id': 'nunique'
        }
    )
    
    # Stage 4: Export Results
    db.export_dataframe(
        'excel',
        'analytics_report.xlsx',
        sheet_name='Results',
        index=True
    )
