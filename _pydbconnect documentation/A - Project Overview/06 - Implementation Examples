# Real-time data processing with window functions
def analyze_real_time_data(db: DatabaseConnection, window_size: int = 100):
    while True:
        results = db.execute_sql_to_panda_dataframe("""
            WITH latest_data AS (
                SELECT *
                FROM metrics
                ORDER BY timestamp DESC
                LIMIT ?
            )
            SELECT 
                timestamp,
                value,
                AVG(value) OVER w as moving_avg,
                STDDEV(value) OVER w as moving_std,
                (value - AVG(value) OVER w) / STDDEV(value) OVER w as z_score
            FROM latest_data
            WINDOW w AS (
                ORDER BY timestamp 
                ROWS BETWEEN ? PRECEDING AND CURRENT ROW
            )
            ORDER BY timestamp DESC
        """, params=(window_size, window_size - 1))
        
