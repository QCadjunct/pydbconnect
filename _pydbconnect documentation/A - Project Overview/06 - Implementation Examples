### 1.2 PostgreSQL Implementation
```python
# Basic PostgreSQL Operations
db = DatabaseConnection("POSTGRESQL") \
    .with_credentials("postgres", "password") \
    .connect()

# Using Common Table Expressions (CTE)
results = db.execute_sql_to_panda_dataframe("""
    WITH MonthlyStats AS (
        SELECT 
            DATE_TRUNC('month', order_date) as month,
            COUNT(*) as order_count,
            SUM(total_amount) as total_revenue
        FROM orders
        GROUP BY DATE_TRUNC('month', order_date)
    )
    SELECT 
        month,
        order_count,
        total_revenue,
        LAG(total_revenue) OVER (ORDER BY month) as prev_month_revenue,
        total_revenue - LAG(total_revenue) OVER (ORDER BY month) as revenue_change
    FROM MonthlyStats
    ORDER BY month
""")

# Using COPY for bulk operations
def bulk_copy_example(db, df: pd.DataFrame, table: str):
    from io import StringIO
    
    # Prepare data buffer
    buffer = StringIO()
    df.to_csv(buffer, index=False, header=False)
    buffer.seek(0)
    
    # Get raw connection for COPY command
    raw_conn = db._connection
    with raw_conn.cursor() as cursor:
        cursor.copy_from(
            buffer,
            table,
            columns=df.columns.tolist(),
            sep=','
        )
    raw_conn.commit()
```

